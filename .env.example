# PostgreSQL — Local geliştirme
DATABASE_URL="postgresql://bebek:bebek123@localhost:5432/bebek_eticaret_db"

# PostgreSQL — Production (docker-compose.prod.yml bu üç değişkenden DATABASE_URL üretir)
POSTGRES_USER="bebek"
POSTGRES_PASSWORD="guclu_bir_sifre_gir"
POSTGRES_DB="bebek_eticaret_db"

# PayTR Ödeme Entegrasyonu
PAYTR_MERCHANT_ID="PAYTR_MAGAZA_NO"
PAYTR_MERCHANT_KEY="PAYTR_MERCHANT_KEY"
PAYTR_MERCHANT_SALT="PAYTR_MERCHANT_SALT"
PAYTR_TEST_MODE="1"
PAYTR_DEBUG_ON="1"
PAYTR_NO_INSTALLMENT="0"
PAYTR_MAX_INSTALLMENT="0"
PAYTR_TIMEOUT_LIMIT="30"
PAYTR_CURRENCY="TL"

# Uygulama URL'si
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Paneli Girişi
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="GUCLU_BIR_PAROLA_GIR"
# En az 32 karakter rastgele değer (örn: openssl rand -base64 32)
ADMIN_SESSION_SECRET="UZUN_RASTGELE_BIR_SECRET_GIR"

# Cloudflare R2 — Ürün görselleri
# Supabase / Vercel ortamına göre kendi public bucket URL'ini gir
NEXT_PUBLIC_R2_PUBLIC_URL="https://<HESAP_ID>.r2.cloudflarestorage.com/<BUCKET_ADI>"

# Resend — E-posta bildirimleri
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="bildirim@alanadiniz.com"

# Upstash Redis — Önbellek (şu an pasif, ileride aktif edilebilir)
UPSTASH_REDIS_REST_URL="https://<SUBDOMAIN>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<UPSTASH_REST_TOKEN>"