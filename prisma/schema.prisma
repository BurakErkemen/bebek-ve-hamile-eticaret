generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VisualTone {
  ROSE
  SAGE
  PEACH
}

enum SliderPlacement {
  HOME_HERO
}

enum BannerPlacement {
  HOME_PROMO
  CATEGORY_PROMO
  GLOBAL_PROMO
}

enum HomeSectionType {
  HERO_SLIDER
  CATEGORY_SHOWCASE
  PROMO_BANNER
  PRODUCT_SHOWCASE
}

enum HomeSectionItemType {
  CATEGORY_CARD
  CUSTOM_LINK
  PRODUCT_REFERENCE
}

enum AttributeDisplayType {
  CHECKBOX
  RADIO
  COLOR_SWATCH
  BADGE
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  NOT_STARTED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?    @db.Text

  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")

  products          Product[]
  homeSectionItems  HomeSectionItem[]
  attributes        CategoryAttribute[]

  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
  @@index([isActive, sortOrder])
}

model Product {
  id               String            @id @default(cuid())

  categoryId       String
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name             String
  slug             String            @unique

  shortDescription String?           @db.Text
  description      String?           @db.Text

  basePrice        Decimal           @db.Decimal(10, 2)
  compareAtPrice   Decimal?          @db.Decimal(10, 2)

  isActive         Boolean           @default(true)
  isFeatured       Boolean           @default(false)
  sortOrder        Int               @default(0)

  variants         ProductVariant[]
  images           ProductImage[]
  homeSectionItems HomeSectionItem[]
  attributeValues  ProductAttributeValue[]
  orderItems       OrderItem[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([categoryId, isActive, sortOrder])
  @@index([isFeatured, isActive])
}

model ProductVariant {
  id               String    @id @default(cuid())

  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku              String    @unique

  size             String?
  colorName        String?
  colorHex         String?

  price            Decimal?  @db.Decimal(10, 2)
  compareAtPrice   Decimal?  @db.Decimal(10, 2)

  stockQuantity    Int       @default(0)

  isActive         Boolean   @default(true)
  sortOrder        Int       @default(0)

  orderItems       OrderItem[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([productId, isActive, sortOrder])
  @@index([size])
  @@index([colorName])
}

model ProductImage {
  id          String   @id @default(cuid())

  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  url         String
  alt         String?

  isPrimary   Boolean  @default(false)
  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId, isPrimary, sortOrder])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?

  orders       Order[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}

model Order {
  id                  String        @id @default(cuid())
  orderNumber         String        @unique
  merchantOid         String?       @unique

  userId              String?
  user                User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  status              OrderStatus   @default(DRAFT)
  paymentStatus       PaymentStatus @default(NOT_STARTED)
  paytrTotalAmount    Decimal?      @db.Decimal(10, 2)
  paymentFailureCode  String?
  paymentFailureMessage String?     @db.Text
  paidAt              DateTime?
  cancelledAt         DateTime?

  customerFirstName   String
  customerLastName    String
  customerEmail       String
  customerPhone       String

  shippingCountry     String        @default("Türkiye")
  shippingCity        String
  shippingDistrict    String
  shippingNeighborhood String?
  shippingPostalCode  String?
  shippingAddressLine String        @db.Text

  customerNote        String?       @db.Text

  subtotal            Decimal       @db.Decimal(10, 2)
  shippingFee         Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount      Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount         Decimal       @db.Decimal(10, 2)

  items               OrderItem[]

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([status, paymentStatus])
  @@index([customerEmail])
  @@index([createdAt])
  @@index([userId])
}

model OrderItem {
  id              String          @id @default(cuid())

  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId       String?
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productName     String
  productSlug     String
  sku             String
  variantLabel    String

  imageUrl        String?

  unitPrice       Decimal         @db.Decimal(10, 2)
  compareAtPrice  Decimal?        @db.Decimal(10, 2)
  quantity        Int
  lineTotal       Decimal         @db.Decimal(10, 2)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Attribute {
  id           String               @id @default(cuid())
  name         String
  slug         String               @unique
  displayType  AttributeDisplayType @default(CHECKBOX)

  isFilterable Boolean              @default(true)
  isVisibleOnProductDetail Boolean @default(true)
  isActive     Boolean              @default(true)
  sortOrder    Int                  @default(0)

  values       AttributeValue[]
  categories   CategoryAttribute[]

  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([isFilterable, isActive, sortOrder])
}

model AttributeValue {
  id           String                  @id @default(cuid())

  attributeId  String
  attribute    Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  value        String
  slug         String

  colorHex     String?
  sortOrder    Int                     @default(0)
  isActive     Boolean                 @default(true)

  productLinks ProductAttributeValue[]

  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@unique([attributeId, slug])
  @@index([attributeId, isActive, sortOrder])
}

model CategoryAttribute {
  id              String    @id @default(cuid())

  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  attributeId     String
  attribute       Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  isFilterVisible Boolean   @default(true)
  sortOrder       Int       @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([categoryId, attributeId])
  @@index([categoryId, isFilterVisible, sortOrder])
}

model ProductAttributeValue {
  id               String         @id @default(cuid())

  productId        String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([productId, attributeValueId])
  @@index([productId])
  @@index([attributeValueId])
}

model Slider {
  id          String          @id @default(cuid())
  name        String
  placement   SliderPlacement @default(HOME_HERO)

  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)

  slides      SliderSlide[]
  sections    HomeSection[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([placement, isActive, sortOrder])
}

model SliderSlide {
  id                   String     @id @default(cuid())

  sliderId             String
  slider               Slider     @relation(fields: [sliderId], references: [id], onDelete: Cascade)

  eyebrow              String?
  title                String
  description          String?    @db.Text

  primaryActionLabel   String?
  primaryActionHref    String?
  secondaryActionLabel String?
  secondaryActionHref  String?

  imageUrl             String?
  imageAlt             String?

  tone                 VisualTone @default(ROSE)

  isActive             Boolean    @default(true)
  sortOrder            Int        @default(0)

  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([sliderId, isActive, sortOrder])
}

model Banner {
  id          String          @id @default(cuid())
  name        String
  placement   BannerPlacement @default(HOME_PROMO)

  eyebrow     String?
  title       String
  description String?         @db.Text

  actionLabel String?
  actionHref  String?

  imageUrl    String?
  imageAlt    String?

  tone        VisualTone      @default(ROSE)

  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)

  sections    HomeSection[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([placement, isActive, sortOrder])
}

model HomeSection {
  id          String          @id @default(cuid())
  type        HomeSectionType

  eyebrow     String?
  title       String?
  description String?         @db.Text

  actionLabel String?
  actionHref  String?

  sliderId    String?
  slider      Slider?         @relation(fields: [sliderId], references: [id], onDelete: SetNull)

  bannerId    String?
  banner      Banner?         @relation(fields: [bannerId], references: [id], onDelete: SetNull)

  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)

  items       HomeSectionItem[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([type, isActive, sortOrder])
  @@index([sliderId])
  @@index([bannerId])
}

model HomeSectionItem {
  id          String              @id @default(cuid())

  sectionId   String
  section     HomeSection         @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  itemType    HomeSectionItemType @default(CUSTOM_LINK)

  categoryId  String?
  category    Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  productId   String?
  product     Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)

  title       String?
  description String?             @db.Text
  href        String?
  badge       String?

  tone        VisualTone          @default(ROSE)

  isActive    Boolean             @default(true)
  sortOrder   Int                 @default(0)

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([sectionId, isActive, sortOrder])
  @@index([itemType])
  @@index([categoryId])
  @@index([productId])
}
model BlogPost {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String?   @db.Text
  content       String    @db.Text
  coverImageUrl String?
  coverImageAlt String?
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  sortOrder     Int       @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isPublished, publishedAt])
  @@index([slug])
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Page {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String   @db.Text
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug, isActive])
}
